# DocAI Environment Configuration (.env.example)
# Copy to .env and fill in with your local values

# ===== MONGODB =====
MONGODB_URI=mongodb://admin:password@localhost:27017/docai?authSource=admin&replicaSet=rs0
MONGODB_DATABASE=docai
MONGODB_USER=admin
MONGODB_PASSWORD=password

# ===== KAFKA =====
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
APICURIO_URL=http://localhost:8081
APICURIO_AUTO_REGISTER=true
# KAFKA_CONSUMER_GROUP supprimé — Consumer Group IDs définis via kafka.groups.* dans application.yml (FR-016b)

# ===== KEYCLOAK =====
KEYCLOAK_URL=http://localhost:8180
KEYCLOAK_REALM=docai
KEYCLOAK_CLIENT_ID=docai-backend
KEYCLOAK_CLIENT_SECRET=change-me-in-production
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# ===== VALKEY (Redis-compatible — licence changée mai 2024) =====
VALKEY_HOST=localhost
VALKEY_PORT=6379
VALKEY_PASSWORD=
VALKEY_SSL_ENABLED=false

# ===== AWS S3 =====
# For production, use real AWS credentials
# For local development, create an IAM user with S3 access
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id-here
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key-here
S3_BUCKET=docai-prod

# ===== STRIPE (Payments) =====
STRIPE_API_KEY=sk_test_YOUR_TEST_KEY_HERE
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET_HERE

# ===== CLAUDE AI / ANTHROPIC =====
ANTHROPIC_API_KEY=sk-ant-YOUR_API_KEY_HERE
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ===== OBSERVABILITY =====
PROMETHEUS_ENABLED=true
OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=docai
MANAGEMENT_PORT=9091

# ===== SPRING PROFILES =====
SPRING_PROFILES_ACTIVE=local

# ===== LOGGING =====
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_DOCAI=DEBUG
LOG_LEVEL_SPRING_WEB=INFO
