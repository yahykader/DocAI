# DocAI Environment Configuration (.env.example)
# Copy to .env and fill in with your local values

# ===== MONGODB =====
MONGODB_URI=mongodb://admin:password@localhost:27017/docai?authSource=admin&replicaSet=rs0
MONGODB_DATABASE=docai
MONGODB_USER=admin
MONGODB_PASSWORD=password

# ===== KAFKA =====
KAFKA_BROKERS=localhost:9092
KAFKA_SCHEMA_REGISTRY=http://localhost:8081
KAFKA_CONSUMER_GROUP=docai-group

# ===== KEYCLOAK =====
KEYCLOAK_AUTH_SERVER_URL=http://localhost:8180
KEYCLOAK_REALM=docai
KEYCLOAK_CLIENT_ID=docai-backend
KEYCLOAK_CLIENT_SECRET=change-me-in-production
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# ===== REDIS/VALKEY =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ===== AWS S3 =====
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=docai-dev
S3_ENDPOINT=http://localhost:9000  # For local MinIO; use s3.amazonaws.com for AWS

# ===== STRIPE (Payments) =====
STRIPE_API_KEY=sk_test_YOUR_TEST_KEY_HERE
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET_HERE

# ===== CLAUDE AI / ANTHROPIC =====
ANTHROPIC_API_KEY=sk-ant-YOUR_API_KEY_HERE
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ===== OBSERVABILITY =====
PROMETHEUS_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=docai

# ===== SPRING PROFILES =====
SPRING_PROFILES_ACTIVE=local

# ===== LOGGING =====
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_DOCAI=DEBUG
LOG_LEVEL_SPRING_WEB=INFO
