<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE module PUBLIC "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!-- DocAI Checkstyle Configuration - ADR-008 Code Quality Standards -->
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="error"/>
    <property name="fileExtensions" value="java"/>

    <!-- Line length check (max 120) -->
    <module name="LineLength">
        <property name="max" value="120"/>
        <property name="ignorePattern" value="^package.*|^import.*|a href|href|http://|https://"/>
    </module>

    <!-- No trailing whitespace -->
    <module name="TrailingWhitespace"/>

    <!-- TreeWalker checks -->
    <module name="TreeWalker">
        <!-- Naming conventions -->
        <module name="TypeName">
            <property name="format" value="^[A-Z][a-zA-Z0-9]*$"/>
        </module>
        <module name="MethodName">
            <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
        </module>
        <module name="ParameterName">
            <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
        </module>
        <module name="LocalVariableName">
            <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
        </module>

        <!-- Method length check (ADR-008: max 20 lines) -->
        <module name="MethodLength">
            <property name="max" value="20"/>
            <property name="countEmpty" value="false"/>
        </module>

        <!-- Parameter count check (ADR-008: max 4 parameters) -->
        <module name="ParameterNumber">
            <property name="max" value="4"/>
            <property name="tokens" value="METHOD_DEF"/>
        </module>

        <!-- Cyclomatic complexity (ADR-008: max 10) -->
        <module name="CyclomaticComplexity">
            <property name="max" value="10"/>
            <property name="switchBlockAsSingleDecision" value="true"/>
        </module>

        <!-- Blank line padding -->
        <module name="EmptyLineSeparator">
            <property name="allowNoEmptyLineBetweenFields" value="false"/>
        </module>

        <!-- No multiple statements per line -->
        <module name="OneStatementPerLine"/>

        <!-- No star imports -->
        <module name="AvoidStarImport"/>

        <!-- Import order -->
        <module name="ImportOrder">
            <property name="groups" value="java,javax,org,fr"/>
            <property name="separated" value="true"/>
        </module>

        <!-- No unused imports -->
        <module name="UnusedImports"/>

        <!-- Whitespace around tokens -->
        <module name="WhitespaceAround">
            <property name="allowEmptyConstructors" value="true"/>
            <property name="allowEmptyMethods" value="true"/>
        </module>

        <!-- Modifier order -->
        <module name="ModifierOrder"/>

        <!-- Javadoc for public classes and methods -->
        <module name="MissingJavadocMethod">
            <property name="scope" value="public"/>
            <property name="allowedAnnotations" value="Override,Test,BeforeEach,AfterEach,BeforeAll,AfterAll"/>
        </module>

        <!-- No magic numbers (except -1, 0, 1, 2) -->
        <module name="MagicNumber">
            <property name="ignoreNumbers" value="-1,0,1,2"/>
            <property name="ignoreHashCodeMethod" value="true"/>
        </module>

        <!-- No assertEquals with floats -->
        <module name="EqualsHashCode"/>

        <!-- Package name convention -->
        <module name="PackageName">
            <property name="format" value="^[a-z]+(\.[a-z][a-z0-9]*)*$"/>
        </module>

        <!-- Indentation (4 spaces) -->
        <module name="Indentation">
            <property name="basicOffset" value="4"/>
            <property name="braceAdjustment" value="0"/>
            <property name="caseIndent" value="4"/>
            <property name="throwsIndent" value="8"/>
            <property name="lineWrappingIndentation" value="8"/>
        </module>
    </module>
</module>
