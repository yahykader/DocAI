        </dependency>

        <!-- === SERIALIZATION & SCHEMA REGISTRY === -->
        <dependency>
            <groupId>org.apache.avro</groupId>
            <artifactId>avro</artifactId>
        </dependency>
        <!-- TODO: Uncomment when implementing Kafka schema registry integration (Phase 4)
        <dependency>
            <groupId>io.apicurio</groupId>
