        <dependency>
            <groupId>fr.docai</groupId>
            <artifactId>docai-domain</artifactId>
        </dependency>
        <dependency>
            <groupId>fr.docai</groupId>
            <artifactId>docai-application</artifactId>
        </dependency>

        <!-- === SPRING BOOT STARTERS === -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <dependency>
