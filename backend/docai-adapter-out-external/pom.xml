    <dependencies>
        <!-- === INTERNAL MODULES === -->
        <dependency>
            <groupId>fr.docai</groupId>
            <artifactId>docai-domain</artifactId>
        </dependency>
        <dependency>
            <groupId>fr.docai</groupId>
            <artifactId>docai-application</artifactId>
        </dependency>

        <!-- === SPRING FRAMEWORK === -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>

