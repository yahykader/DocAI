{
  "type": "record",
  "name": "DocumentFailedEvent",
  "namespace": "fr.docai.kafka.events",
  "doc": "Event published when document processing fails. ADR-002: documentId is the partition key.",
  "fields": [
    {
      "name": "documentId",
      "type": "string",
      "doc": "Unique document identifier (partition key per ADR-002)"
    },
    {
      "name": "tenantId",
      "type": "string",
      "doc": "Tenant identifier for multi-tenancy"
    },
    {
      "name": "failureStage",
      "type": "string",
      "doc": "Processing stage where failure occurred (e.g., UPLOAD, CLASSIFICATION, EXTRACTION, FRAUD_ANALYSIS)"
    },
    {
      "name": "errorCode",
      "type": "string",
      "doc": "Error code for categorization (e.g., INVALID_FILE_FORMAT, OCR_FAILED, NETWORK_TIMEOUT)"
    },
    {
      "name": "occurredAt",
      "type": "long",
      "doc": "Event timestamp (epoch milliseconds)"
    }
  ]
}
