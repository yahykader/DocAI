{
  "type": "record",
  "name": "DocumentFraudAnalyzedEvent",
  "namespace": "fr.docai.kafka.events",
  "doc": "Event published when fraud analysis is completed. ADR-002: documentId is the partition key.",
  "fields": [
    {
      "name": "documentId",
      "type": "string",
      "doc": "Unique document identifier (partition key per ADR-002)"
    },
    {
      "name": "tenantId",
      "type": "string",
      "doc": "Tenant identifier for multi-tenancy"
    },
    {
      "name": "fraudScore",
      "type": "int",
      "doc": "Overall fraud risk score (0-100)"
    },
    {
      "name": "riskLevel",
      "type": {
        "type": "enum",
        "name": "RiskLevel",
        "symbols": ["FAIBLE", "MODERE", "ELEVE", "CRITIQUE"],
        "doc": "Risk level classification (FR: FAIBLE=Low, MODERE=Medium, ELEVE=High, CRITIQUE=Critical)"
      },
      "doc": "Risk level classification"
    },
    {
      "name": "signals",
      "type": {
        "type": "array",
        "items": {
          "type": "record",
          "name": "FraudSignal",
          "fields": [
            {
              "name": "signalType",
              "type": "string",
              "doc": "Type of fraud signal (e.g., date_mismatch, amount_inconsistency, registry_not_found)"
            },
            {
              "name": "severity",
              "type": {
                "type": "enum",
                "name": "SignalSeverity",
                "symbols": ["INFO", "WARNING", "CRITICAL"],
                "doc": "Severity of the signal"
              },
              "doc": "Severity of the signal"
            },
            {
              "name": "description",
              "type": "string",
              "doc": "Human-readable description of the signal"
            }
          ]
        }
      },
      "default": [],
      "doc": "Array of fraud signals detected"
    },
    {
      "name": "occurredAt",
      "type": {"type": "long", "logicalType": "timestamp-millis"},
      "doc": "Event timestamp (epoch milliseconds)"
    }
  ]
}
