            </dependency>
            <dependency>
                <groupId>fr.docai</groupId>
                <artifactId>docai-adapter-in-kafka</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>fr.docai</groupId>
                <artifactId>docai-adapter-out-mongodb</artifactId>
