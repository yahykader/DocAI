<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>fr.docai</groupId>
    <artifactId>docai-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>DocAI Parent</name>
    <description>B2B SaaS Platform for Intelligent Document Processing - Parent POM</description>

    <!-- Child Modules (Hexagonal Architecture: 11 modules) -->
    <modules>
        <module>docai-domain</module>
        <module>docai-application</module>
        <module>docai-commons</module>
        <module>docai-adapter-in-rest</module>
        <module>docai-adapter-in-kafka</module>
        <module>docai-adapter-out-mongodb</module>
        <module>docai-adapter-out-kafka</module>
        <module>docai-adapter-out-valkey</module>
        <module>docai-adapter-out-ai</module>
        <module>docai-adapter-out-storage</module>
        <module>docai-adapter-out-external</module>
        <module>docai-bootstrap</module>
    </modules>

    <!-- Properties: JDK, Spring Boot, dependency versions (ADR-008: Exact Stack) -->
    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.plugin.version>3.12.1</maven.compiler.plugin.version>

        <!-- Core Stack: Java 21 + Spring Boot 4.0.x -->
        <spring-boot.version>4.0.0</spring-boot.version>
        <spring-cloud.version>2025.0.0</spring-cloud.version>
        <java.version>21</java.version>

        <!-- Testing: JUnit 5, Mockito, ArchUnit (1.3.0 per ADR-008) -->
        <archunit.version>1.3.0</archunit.version>
        <pitest.version>1.17.1</pitest.version>
        <testcontainers.version>1.20.4</testcontainers.version>
        <wiremock.version>3.9.1</wiremock.version>
        <cucumber.version>7.20.1</cucumber.version>

        <!-- Code Quality: Checkstyle, SonarCloud -->
        <checkstyle.version>10.13.0</checkstyle.version>
        <sonarcloud.maven.plugin.version>3.10.0.2594</sonarcloud.maven.plugin.version>

        <!-- Resilience & Rate Limiting — 2.4.2 (plan.md cible 2.3.0 ; bump requis pour compatibilité Spring Boot 4.0.x + fix CB slidingWindowSize) -->
        <resilience4j.version>2.3.0</resilience4j.version>
        <bucket4j.version>8.10.1</bucket4j.version>

        <!-- Mapping & Data -->
        <mapstruct.version>1.6.3</mapstruct.version>
        <lombok.version>1.18.36</lombok.version>

        <!-- Serialization & Schema -->
        <avro.version>1.11.4</avro.version>
        <apicurio.version>2.6.5.Final</apicurio.version>
        <protobuf.version>3.24.4</protobuf.version>

        <!-- Persistence & Migrations -->
        <mongodb.version>4.11.1</mongodb.version>
        <mongock.version>5.4.4</mongock.version>

        <!-- Document Processing -->
        <tess4j.version>5.13.0</tess4j.version>
        <pdfbox.version>3.0.3</pdfbox.version>
        <tika.version>2.9.2</tika.version>
        <javacv.version>1.5.11</javacv.version>
        <!-- JavaCV Platform includes native bindings for all OS (fixes transitive javacpp conflicts) -->
        <javacpp.version>1.5.11</javacpp.version>

        <!-- Cloud & Storage -->
        <aws-sdk.version>2.25.70</aws-sdk.version>
        <spring-cloud-aws.version>3.1.0</spring-cloud-aws.version>

        <!-- Payments & Stripe -->
        <stripe-java.version>23.10.0</stripe-java.version>

        <!-- Message Queue -->
        <kafka.version>3.7.0</kafka.version>

        <!-- Cache -->
        <lettuce.version>6.3.1.RELEASE</lettuce.version>

        <!-- Security & Authentication -->
        <keycloak.version>26.0.0</keycloak.version>
        <jjwt.version>0.12.3</jjwt.version>

        <!-- API Documentation & Contracts -->
        <springdoc.version>2.8.6</springdoc.version>
        <spring-cloud-contract.version>4.1.1</spring-cloud-contract.version>

        <!-- Feature Flags -->
        <unleash.version>9.2.0</unleash.version>

        <!-- LLM Integration -->
        <langchain4j.version>0.31.0</langchain4j.version>

        <!-- Observability & Metrics -->
        <micrometer.version>1.13.0</micrometer.version>
        <opentelemetry.version>1.38.0</opentelemetry.version>
        <logstash-logback-encoder.version>8.0</logstash-logback-encoder.version>

        <!-- Maven Plugin Versions -->
        <maven-jar-plugin.version>3.3.0</maven-jar-plugin.version>
        <maven-surefire-plugin.version>3.1.2</maven-surefire-plugin.version>
        <maven-failsafe-plugin.version>3.1.2</maven-failsafe-plugin.version>
        <maven-shade-plugin.version>3.5.0</maven-shade-plugin.version>
        <jacoco-maven-plugin.version>0.8.10</jacoco-maven-plugin.version>
        <protobuf-maven-plugin.version>0.6.1</protobuf-maven-plugin.version>
    </properties>

    <!-- Dependency Management: Centralized versions for all modules (ADR-008) -->
