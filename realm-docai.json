  "roles": {
    "realm": [
      {
        "name": "admin",
        "description": "Administrator role (system-wide)"
      },
      {
        "name": "tenant-admin",
        "description": "Tenant administrator (manage tenant users and settings)"
      },
      {
        "name": "manager",
        "description": "Manager (oversee operations)"
      },
      {
        "name": "analyst",
        "description": "Analyst (analyze documents)"
      },
      {
        "name": "viewer",
        "description": "Viewer (read-only access)"
      },
      {
        "name": "fraud-reviewer",
        "description": "Fraud reviewer (detect and validate fraud)"
      },
      {
        "name": "offline_access",
        "description": "Offline access"
      },
      {
        "name": "uma_authorization",
        "description": "User-Managed Access authorization"
      }
    ]
