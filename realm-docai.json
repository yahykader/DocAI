  "clients": [
    {
      "clientId": "docai-backend",
      "enabled": true,
      "description": "DocAI Backend API",
      "rootUrl": "http://localhost:8080",
      "redirectUris": [
        "http://localhost:8080/*"
      ],
      "publicClient": false,
      "bearerOnly": true,
      "protocolMappers": [
        {
          "name": "tenant_id mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "tenant_id",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "tenant_id",
            "claim.value.type": "String"
          }
        }
      ]
    },
    {
      "clientId": "docai-frontend",
      "enabled": true,
      "description": "DocAI Frontend (Angular)",
      "rootUrl": "http://localhost:4200",
      "redirectUris": [
        "http://localhost:4200/*",
        "http://localhost:4200/auth/callback"
      ],
      "webOrigins": [
        "http://localhost:4200"
      ],
      "publicClient": true,
      "protocolMappers": [
        {
          "name": "tenant_id mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "tenant_id",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "tenant_id",
            "claim.value.type": "String"
          }
        }
      ]
    },
    {
      "clientId": "docai-admin",
      "enabled": true,
      "description": "DocAI Admin Console",
      "rootUrl": "http://localhost:8080",
      "redirectUris": [
        "http://localhost:8080/admin/*"
      ],
      "publicClient": false,
      "protocolMappers": [
        {
          "name": "tenant_id mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "tenant_id",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "tenant_id",
            "claim.value.type": "String"
          }
        }
      ]
    }
