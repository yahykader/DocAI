{
  "realm": "docai",
  "enabled": true,
  "accessTokenLifespan": 300,
  "accessCodeLifespan": 60,
  "refreshTokenMaxReuse": 0,
  "refreshTokenLifespan": 1800,
  "offlineSessionIdleTimeout": 2592000,
  "offlineSessionMaxLifespan": 5184000,
  "accessCodeLifespanUserAction": 300,
  "actionTokenGeneratedByAdminLifespan": 43200,
  "actionTokenGeneratedByUserLifespan": 300,
  "defaultRoles": [
    "offline_access",
    "uma_authorization"
  ],
  "requiredCredentials": [
    "password"
  ],
  "passwordPolicy": "length(8) and specialChars(1) and upperCase(1) and lowerCase(1) and digits(1)",
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyInitialCounter": 0,
  "otpPolicyDigits": 6,
  "otpPolicyLookAheadWindow": 1,
  "otpPolicyPeriod": 30,
  "otpSupportedApplications": [
    "FreeOTP",
    "Google Authenticator"
  ],
  "users": [
    {
      "username": "admin",
      "email": "admin@docai.local",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Admin",
      "lastName": "User",
      "credentials": [
        {
          "type": "password",
          "value": "Admin1234!"
        }
      ],
      "realmRoles": [
        "user",
        "admin"
      ],
      "clientRoles": {
        "realm-management": [
          "manage-users",
          "manage-clients",
          "manage-events"
        ],
        "account": [
          "manage-account"
        ]
      },
      "attributes": {
        "tenant_id": [
          "acme-corp"
        ]
      }
    },
    {
      "username": "testuser",
      "email": "test@acme-corp.local",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Test",
      "lastName": "User",
      "credentials": [
        {
          "type": "password",
          "value": "Test1234!"
        }
      ],
      "realmRoles": [
        "user"
      ],
      "clientRoles": {
        "account": [
          "manage-account"
        ]
      },
      "attributes": {
        "tenant_id": [
          "acme-corp"
        ]
      }
    }
  ],
  "roles": {
    "realm": [
      {
        "name": "admin",
        "description": "Administrator role"
      },
      {
        "name": "user",
        "description": "User role"
      },
      {
        "name": "offline_access",
        "description": ""
      },
      {
        "name": "uma_authorization",
        "description": ""
      }
    ],
    "client": {
      "realm-management": [
        {
          "name": "manage-users",
          "description": "Manage users"
        },
        {
          "name": "manage-clients",
          "description": "Manage clients"
        },
        {
          "name": "manage-events",
          "description": "Manage events"
        }
      ],
      "account": [
        {
          "name": "manage-account",
          "description": "Manage account"
        }
      ]
    }
  },
  "clients": [
    {
      "clientId": "docai-backend",
      "name": "DocAI Backend",
      "description": "Backend API client",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "docai-backend-secret-change-in-prod",
      "redirectUris": [
        "http://localhost:8080/*"
      ],
      "webOrigins": [
        "http://localhost:8080"
      ],
      "publicClient": false,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "bearerOnlyClient": false,
      "consentRequired": false,
      "fullScopeAllowed": true,
      "defaultClientScopes": [
        "profile",
        "email"
      ],
      "optionalClientScopes": [
        "address",
        "phone"
      ],
      "protocolMappers": [
        {
          "name": "tenant_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "tenant_id",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "tenant_id"
          }
        },
        {
          "name": "email",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "email",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "email"
          }
        },
        {
          "name": "given name",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "firstName",
            "id.token.claim": "true",
            "access.token.claim": false,
            "claim.name": "given_name"
          }
        },
        {
          "name": "family name",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "lastName",
            "id.token.claim": "true",
            "access.token.claim": false,
            "claim.name": "family_name"
          }
        },
        {
          "name": "roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "multivalued": "true",
            "user.attribute": "foo",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "roles"
          }
        }
      ]
    },
    {
      "clientId": "docai-frontend",
      "name": "DocAI Frontend",
      "description": "Frontend Angular application",
      "enabled": true,
      "publicClient": true,
      "redirectUris": [
        "http://localhost:4200/*",
        "http://localhost:4200"
      ],
      "webOrigins": [
        "http://localhost:4200"
      ],
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": true,
      "allowedOrigins": [
        "http://localhost:4200"
      ],
      "defaultClientScopes": [
        "profile",
        "email",
        "openid"
      ],
      "optionalClientScopes": [
        "address",
        "phone"
      ],
      "protocolMappers": [
        {
          "name": "tenant_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "tenant_id",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "tenant_id"
          }
        },
        {
          "name": "email",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "email",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "email"
          }
        },
        {
          "name": "given name",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "firstName",
            "id.token.claim": "true",
            "access.token.claim": false,
            "claim.name": "given_name"
          }
        },
        {
          "name": "family name",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "lastName",
            "id.token.claim": "true",
            "access.token.claim": false,
            "claim.name": "family_name"
          }
        }
      ]
    },
    {
      "clientId": "docai-admin",
      "name": "DocAI Admin",
      "description": "Admin console client",
      "enabled": true,
      "publicClient": true,
      "redirectUris": [
        "http://localhost:8180/admin/*",
        "http://localhost:8180/admin"
      ],
      "webOrigins": [
        "http://localhost:8180"
      ],
      "standardFlowEnabled": true,
      "implicitFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "defaultClientScopes": [
        "profile",
        "email",
        "openid"
      ]
    }
  ],
  "clientScopeMappings": {
    "realm-management": [
      {
        "client": "docai-backend",
        "roles": [
          "manage-users",
          "manage-clients"
        ]
      }
    ]
  },
  "smtpServer": {
    "host": "localhost",
    "port": 1025,
    "from": "noreply@docai.local",
    "auth": false,
    "ssl": false,
    "starttls": false
  },
  "eventsEnabled": true,
  "eventsListeners": [
    "jboss-logging"
  ],
  "enabledEventTypes": [
    "REGISTER",
    "REGISTER_ERROR",
    "LOGIN",
    "LOGIN_ERROR",
    "CLIENT_LOGIN",
    "CLIENT_LOGIN_ERROR",
    "LOGOUT",
    "LOGOUT_ERROR"
  ],
  "internationalizationEnabled": true,
  "supportedLocales": [
    "en",
    "fr"
  ],
  "defaultLocale": "en",
  "userManagedAccessAllowed": true,
  "attributes": {
    "cidr.check.disabled": "true",
    "frontendUrl": "http://localhost:4200"
  }
}
